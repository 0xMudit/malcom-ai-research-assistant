# Application URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# AI runtime (Ollama-compatible /api/chat endpoint)
MALCOM_MODEL=hf.co/HauhauCS/Qwen3.5-2B-Uncensored-HauhauCS-Aggressive:latest
MALCOM_LLM_BASE_URL=http://127.0.0.1:11434
MALCOM_NUM_PREDICT=2048
MALCOM_MAX_NUM_PREDICT=4096
MALCOM_REQUEST_TIMEOUT_MS=170000

# Web research. Brave is optional; DuckDuckGo Lite is the fallback.
MALCOM_WEB_RESEARCH_SEARCH_RESULTS=6
MALCOM_WEB_RESEARCH_FETCH_RESULTS=4
BRAVE_SEARCH_API_KEY=

# Supabase (optional; local SQLite is used when these are unset)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional second Supabase project used as a backup store
SUPABASE_BACKUP_URL=
SUPABASE_BACKUP_SERVICE_ROLE_KEY=

# Optional direct database URL for `npm run supabase:apply-schema`
SUPABASE_DB_URL=
DATABASE_URL=

# Stripe billing (optional)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO=999
STRIPE_PRICE_ID_ENTERPRISE=2999
STRIPE_CURRENCY=usd

# Production admin access. Use unique, randomly generated values.
MALCOM_ADMIN_USER=
MALCOM_ADMIN_PASSWORD=
MALCOM_ADMIN_SESSION_SECRET=

# Optional Redis-compatible cache. KV_URL is accepted as a fallback.
REDIS_URL=
KV_URL=
REDIS_CACHE_PREFIX=malcom

# Optional alternate Next.js build directory (used by parallel dev workflows)
NEXT_DIST_DIR=.next
